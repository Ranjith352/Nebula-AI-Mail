# ─── Google OAuth / Gmail API ─────────────────────────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match a URI registered in Google Cloud Console → OAuth 2.0 Client
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/callback
GMAIL_COMPLAINTS_LABEL=Complaints

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-byte-hex-string
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local: mongodb://localhost:27017/nebula)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nebula?retryWrites=true&w=majority

# ─── Generative AI (Pluggable LLM Provider: groq | ollama) ──────────────────
LLM_PROVIDER=groq

# Groq (cloud, free tier available — https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-groq-70b-8192-tool-use-preview

# Ollama (local, optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Google Cloud Pub/Sub (optional — for real-time push notifications) ───────
# Required only for Gmail Watch (real-time inbox updates without polling)
# See: https://console.cloud.google.com/cloudpubsub
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_NAME=gmail-push-notifications
PUBSUB_SUBSCRIPTION_NAME=gmail-push-sub
